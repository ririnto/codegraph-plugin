{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "module": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "release/**/*.mjs",
    "rules/**/*.ts",
    "tests/**/*.mjs",
    "tests/**/*.ts"
  ]
}
