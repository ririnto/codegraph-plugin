{
  "name": "codegraph-plugin",
  "displayName": "CodeGraph",
  "version": "2026.11.19.01",
  "description": "Find symbols and trace calls with automatic Git checkout indexing.",
  "author": {
    "name": "ririnto"
  },
  "license": "MIT",
  "hooks": {
    "version": 1,
    "hooks": {
      "sessionStart": [
        {
          "command": "sh -c 'exec sh ./hooks/exclude.sh \"\"\"$CURSOR_PROJECT_DIR\"\"\"'"
        },
        {
          "command": "sh -c 'exec sh ./hooks/init.sh \"\"\"$CURSOR_PROJECT_DIR\"\"\"'",
          "timeout": 3600
        }
      ]
    }
  },
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "sh",
      "args": [
        "-c",
        "exec npx --yes @colbymchenry/codegraph serve --mcp"
      ],
      "env": {
        "NODE_USE_SYSTEM_CA": "1"
      }
    }
  }
}
