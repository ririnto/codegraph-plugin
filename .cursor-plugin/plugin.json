{
  "name": "codegraph-plugin",
  "displayName": "CodeGraph",
  "version": "1.0.3",
  "description": "Find symbols and trace calls with automatic Git checkout indexing.",
  "author": {
    "name": "ririnto"
  },
  "license": "MIT",
  "hooks": {
    "version": 1,
    "hooks": {
      "sessionStart": [
        {
          "command": "sh ./hooks/cursor-workspace.sh ./hooks/exclude.sh"
        },
        {
          "command": "sh ./hooks/cursor-workspace.sh ./hooks/init.sh",
          "timeout": 3600
        }
      ]
    }
  }
}
