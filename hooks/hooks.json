{
  "description": "Prepare the active repository for CodeGraph indexing.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/exclude.sh\"",
            "timeout": 3600,
            "statusMessage": "Configuring CodeGraph exclusion for Git checkout root",
            "async": true
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/init.sh\"",
            "async": true,
            "timeout": 3600,
            "statusMessage": "Initializing CodeGraph at Git checkout root"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/init.sh\"",
            "async": true,
            "timeout": 3600,
            "statusMessage": "Initializing CodeGraph at Git checkout root"
          }
        ]
      }
    ]
  }
}
